NAMY_INBOUND_KEY=               # optional: key NAMY sends on POST /api/webhooks/namy; defaults to NAMY_API_KEY (one shared key, NAMY vault wanym_site_api_key)
NAMY_API_KEY=                   # shared key = NAMY vault secret wanym_site_api_key (select public.wanym_site_key() as service_role); prices, slots, orders and status callbacks
