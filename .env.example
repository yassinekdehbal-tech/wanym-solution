STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=           # 1 = Stripe Tax computes the VAT (needs an ACTIVE FR registration in Stripe → Tax); empty = NAMY's TTC is charged
STRIPE_TAX_CODE=                # product tax code for transport services from https://docs.stripe.com/tax/tax-codes (account preset when empty)
STRIPE_INVOICE_DAYS_DUE=30      # payment term of Stripe invoices (POST /api/orders/[id]/invoice)          # whsec_… (endpoint: /api/webhooks/stripe)
